# Plex integration (optional)
PLEX_URL=http://localhost:32400
# PLEX_TOKEN=your-plex-token
# Fixed 720p profile; optional override is limited to 4000-4800 Kbps.
# PLEX_VIDEO_BITRATE_KBPS=4800

# Server (optional)
# The root .env is loaded automatically; exported variables take precedence.
# DRIVEIN_ENV_FILE=/absolute/path/to/custom.env
# PORT=9090
# LOG_LEVEL=info
# DRIVEIN_DB=.drive-in.sqlite
# SEGMENT_CACHE_MAX_BYTES=21474836480
# STREAM_MAX_VIDEO_BITRATE_KBPS=4800
# DASH_TRANSCODE=0

# yt-dlp authentication (optional; default is anonymous, no browser required)
# Set one when the source needs login or browser cookies. A file takes precedence.
# YTDLP_COOKIES_FROM_BROWSER=chrome
# YTDLP_COOKIES_FILE=/absolute/path/to/cookies.txt

# CLI remote server (optional, defaults to http://localhost:9090)
# DRIVEIN_SERVER=http://localhost:9090
